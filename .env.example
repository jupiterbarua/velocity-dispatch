# Copy to .env for local docker-compose runs. All of these have sane
# LocalStack-pointed defaults baked into the services already (see
# services/*/src/config.rs), so a plain `docker compose up` works with no
# .env file at all — this exists mainly to document every knob in one place.

DATABASE_URL=postgres://dispatch:dispatch@postgres:5432/dispatch
DB_MAX_CONNECTIONS=20

# Point at LocalStack by default; swap for real queue/bus ARNs & URLs in
# infra/terraform's outputs when deploying to real AWS.
AWS_ENDPOINT_URL=http://localstack:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=eu-central-1

SQS_ORDER_QUEUE_URL=http://localstack:4566/000000000000/order-created
EVENT_BUS_NAME=velocity-dispatch-bus
MATCH_RADIUS_KM=15
MAX_IN_FLIGHT=20

BIND_ADDR=0.0.0.0:8080

# dispatch-notify-lambda (unset = logs only, no real SNS/S3 call — see
# services/dispatch-notify-lambda/src/{notify,audit}.rs)
AUDIT_BUCKET=velocity-dispatch-audit
NOTIFY_TOPIC_ARN=
